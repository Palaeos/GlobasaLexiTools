{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Extend TMX with Tell-Tale Heart parallel text",
      "type": "process",
      "command": "python3",
      "args": ["fill_telltale_english.py"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Generate TMX from CSV",
      "type": "process",
      "command": "python3",
      "args": ["make_tmx.py"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Extend TMX with UDHR (Spanish + Esperanto)",
      "type": "process",
      "command": "python3",
      "args": ["extend_tmx_udhr.py"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Extend TMX with multilingual data (Vanege, Xwexi, Ektor, Pepper & Carrot)",
      "type": "process",
      "command": "python3",
      "args": ["extend_tmx_eo.py"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Sense Judge (script tiers only)",
      "type": "shell",
      "command": "LD_LIBRARY_PATH=/usr/local/cuda-12.0/targets/x86_64-linux/lib:$LD_LIBRARY_PATH /usr/bin/python3 -u LLM_sense_judge.py --no-llm",
      "group": "build",
      "isBackground": false,
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Sense Judge (with Qwen LLM)",
      "type": "shell",
      "command": "LD_LIBRARY_PATH=/usr/local/cuda-12.0/targets/x86_64-linux/lib:$LD_LIBRARY_PATH /usr/bin/python3 -u LLM_sense_judge.py",
      "group": "build",
      "isBackground": false,
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Word Viewer: Rebuild LMDB & Start",
      "type": "shell",
      "command": "rm -rf WordViewerLMDB && ${workspaceFolder}/venv/bin/python3 'Word Viewer.py'",
      "group": "build",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building WordViewerLMDB",
          "endsPattern": "Running on"
        }
      }
    },
    {
      "label": "Word Viewer",
      "type": "process",
      "command": "${workspaceFolder}/venv/bin/python3",
      "args": ["Word Viewer.py"],
      "group": "build",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running on",
          "endsPattern": "Running on"
        }
      }
    },
    {
      "label": "Word Selector",
      "type": "process",
      "command": "${workspaceFolder}/venv/bin/python3",
      "args": ["-u", "Word Selector.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running on",
          "endsPattern": "Running on"
        }
      }
    },
    {
      "label": "English Wiktionary Sense Extender",
      "type": "process",
      "command": "${workspaceFolder}/venv/bin/python3",
      "args": ["-u", "Wiktionary sense based translation extender 3.py"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Wiktionary Extension Builder",
      "type": "process",
      "command": "${workspaceFolder}/venv/bin/python3",
      "args": ["-u", "Wiktionary extension builder.py"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Multi-Wiktionary Sense Curator",
      "type": "process",
      "command": "${workspaceFolder}/venv/bin/python3",
      "args": ["-u", "Multi-Wiktionary sense curator.py"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Build Wiktionary Extensions (full pipeline)",
      "dependsOn": [
        "English Wiktionary Sense Extender",
        "Wiktionary Extension Builder"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Regenerate TMX (full pipeline)",
      "dependsOn": [
        "Generate TMX from CSV",
        "Extend TMX with Tell-Tale Heart parallel text",
        "Extend TMX with UDHR (Spanish + Esperanto)",
        "Extend TMX with multilingual data (Vanege, Xwexi, Ektor, Pepper & Carrot)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run eflomal alignment (all language pairs)",
      "type": "process",
      "command": "${workspaceFolder}/venv/bin/python3",
      "args": ["-u", "run_giza_improved.py", "--eflomal"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Run eflomal alignment (one language pair)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python3",
      "args": [
        "-u",
        "-c",
        "import sys; from run_giza_improved import extract_parallel, run_eflomal, multiway_concordance, TMX_FILE, OUT_DIR; lang = '${input:targetLang}'; OUT_DIR.mkdir(exist_ok=True); conc = multiway_concordance(TMX_FILE); pairs = extract_parallel(TMX_FILE, 'glb', lang); run_eflomal('glb', lang, pairs, OUT_DIR / f'glb_{lang}', concordance_pairs=conc)"
      ],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "targetLang",
      "type": "pickString",
      "description": "Target language code",
      "default": "en",
      "options": ["en", "eo", "es", "de", "fr", "ru", "nl", "pt", "id", "da", "ar", "hi", "sw", "tr", "zh"]
    }
  ]
}
