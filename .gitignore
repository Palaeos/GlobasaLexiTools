# Downloaded speech model (1.26 GB, its own git clone): see lesson_audio_labels.py
Models/
# Lesson recordings decoded to WAV for the /splits page
LessonAudioLabels/.cache/

# Word Selector caches and downloaded third-party data (never commit: e.g. GPL dictionaries)
word_selection_cache/
# Parallel lexical selection (Le Petit Prince etc.): corpus downloads, alignments, drafts, TMX. Text stays out of git.
parallel_lexsel_cache/

# Word Viewer: local environment, downloaded word list and the cache built from it
venv/
word-list.csv
WordViewerLMDB/
WordViewerLMDB.building/
__pycache__/

# Working copies of the vetting spreadsheets (decisions are stored in their own file)
vetting_import/
WiktionaryLMDB_vetted/
WiktionaryLMDB_vetted.building/
WiktionaryLMDB_senses/
WiktionaryLMDB_senses.building/

# Expanded vetting views: regenerated from vetted_senses.tsv + the dump
GLB_ENG_WiktionarySenses*.tsv
GLB_ENG_WiktionarySenses*.xlsx

# Lute (lute_doxo_sync.py): its own virtualenv, its data (database, book audio,
# backups) and the config written with this machine's absolute path
venv-lute/
LuteGlobasa/data/
LuteGlobasa/config.yml
bible-translation/sources/
bible-translation/apertium-hbo-glb/*.bin
bible-translation/data/*.log

# Apertium checkouts: only the Globasa pairs are tracked (as submodules);
# upstream monolinguals, the apertium .deb, glb-en and mtnprox stay local.
GlobasaTranslation/*
!GlobasaTranslation/apertium-glb
!GlobasaTranslation/apertium-glb-*
GlobasaTranslation/apertium-glb-en
